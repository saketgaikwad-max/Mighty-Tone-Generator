{
  "name": "mighty-tone-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Natural-language tone requests to NUX Mighty Space patches (QR).",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "extract": "node tools/extract-plugpro.ts",
    "decode-fixtures": "node tools/decode-fixture-qr.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "konsta": "^5.0.3",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "^4.0.0",
    "globals": "^16.2.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}
